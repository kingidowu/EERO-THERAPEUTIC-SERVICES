# Copy to the repository root as .env, or use manage.py init-local for local keys.
# Never commit populated secrets. Run the web backend on Python 3.12 or later.
EERO_SESSION_SECRET=
EERO_VAULT_KEY=
EERO_DATABASE=eero.db
EERO_PUBLIC_URL=http://127.0.0.1:8020
# Localhost development only; omit this on an HTTPS deployment.
EERO_LOCAL_HTTP=1
# New Google Cloud OAuth Web Application client credentials:
EERO_OIDC_CLIENT_ID=
EERO_OIDC_CLIENT_SECRET=
EERO_OIDC_ISSUER=https://accounts.google.com
EERO_OIDC_METADATA_URL=https://accounts.google.com/.well-known/openid-configuration
